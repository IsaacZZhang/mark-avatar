.page {
  min-height: 100vh;
  background: #f5f5f7;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.preview {
  width: 100%;
  height: 560rpx;
  border-radius: 16rpx;
  background: #eee;
}

.tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

.guide {
  margin-top: 32rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx;
}

.guide-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 20rpx;
}

.step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.idx {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: #07c160;
  color: #fff;
  font-size: 22rpx;
  margin-right: 16rpx;
  margin-top: 4rpx;
}

.txt {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.note {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #a0a0a0;
  line-height: 1.5;
}

.actions {
  margin-top: 40rpx;
}

.btn {
  font-size: 30rpx;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  border: none;
}

.btn::after {
  border: none;
}

.btn.primary {
  background: #07c160;
  color: #fff;
}

.btn.primary:active {
  background: #06ad56;
}

.sub {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.btn.ghost {
  flex: 1;
  background: #fff;
  color: #333;
  font-size: 28rpx;
}

.restart {
  margin-top: 28rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8a8a8a;
}
